@page "/blocks/new"
@page "/blocks/edit/{Id:int}"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using SkillRoute_BlazorApp.Infrastructure
@using SkillRoute_BlazorApp.Model
@inject SkillRouteDbContext DbContext
@inject NavigationManager Navigation

<PageTitle>@PageTitleText</PageTitle>

@if (isLoading)
{
    <p>Baustein wird geladen.</p>
}
else if (Id.HasValue && block is null)
{
    <div class="page-header">
        <h1>Baustein nicht gefunden</h1>
    </div>

    <a class="btn btn-outline-secondary" href="/blocks">Zurück</a>
}
else
{
    <div class="page-header">
        <h1>@PageTitleText</h1>
    </div>

    <EditForm Model="form" OnValidSubmit="SaveBlockAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label" for="block-title">Titel</label>
            <InputText id="block-title" class="form-control" @bind-Value="form.Title" />
            <ValidationMessage For="() => form.Title" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="block-description">Beschreibung</label>
            <InputTextArea id="block-description" class="form-control" rows="4" @bind-Value="form.Description" />
        </div>

        <div class="mb-4">
            <label class="form-label" for="block-status">Status</label>
            <InputSelect id="block-status" class="form-select" @bind-Value="form.Status">
                @foreach (var status in Enum.GetValues<BlockStatus>())
                {
                    <option value="@status">@GetStatusText(status)</option>
                }
            </InputSelect>
        </div>

        @if (block is not null)
        {
            <section class="border rounded p-4 mb-4">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                    <h2 class="h4 mb-0">Bestandteile bearbeiten</h2>

                    @if (availableChildBlocks.Count > 0)
                    {
                        <div class="d-flex flex-wrap gap-2">
                            <select class="form-select" @bind="selectedChildBlockId" aria-label="Bestandteil auswählen">
                                <option value="0">Baustein auswählen</option>
                                @foreach (var availableBlock in availableChildBlocks)
                                {
                                    <option value="@availableBlock.Id">@availableBlock.Title</option>
                                }
                            </select>

                            <button class="btn btn-outline-primary" type="button" @onclick="AddPartAsync">
                                Bestandteil hinzufügen
                            </button>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(partMessage))
                {
                    <div class="alert alert-secondary py-2" role="status">
                        @partMessage
                    </div>
                }

                @if (parts.Count == 0)
                {
                    <p class="text-secondary mb-0">Dieser Baustein hat noch keine Bestandteile.</p>
                }
                else
                {
                    <div class="list-group list-group-flush border-top border-bottom">
                        @foreach (var part in parts)
                        {
                            <div class="list-group-item px-0 py-3">
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                                    <div>
                                        <h3 class="h5 mb-1">@part.ChildBlock.Title</h3>
                                        <p class="mb-0 text-secondary">Status: @GetStatusText(part.ChildBlock.Status)</p>
                                    </div>

                                    <button class="btn btn-outline-danger btn-sm" type="button" @onclick="() => RemovePartAsync(part.Id)">
                                        Entfernen
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (availableChildBlocks.Count == 0)
                {
                    <p class="text-secondary mb-0 mt-3">Es gibt keinen weiteren Baustein zum Hinzufügen.</p>
                }
            </section>
        }

        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-primary" type="submit">Speichern</button>
            <a class="btn btn-outline-secondary" href="@BackLink">Zurück</a>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private LearningBlock? block;
    private BlockForm form = new();
    private List<BlockPart> parts = [];
    private List<LearningBlock> availableChildBlocks = [];
    private bool isLoading = true;
    private int selectedChildBlockId;
    private string? partMessage;

    private string PageTitleText => Id.HasValue ? "Baustein bearbeiten" : "Neuer Baustein";

    private string BackLink => Id.HasValue ? $"/blocks/{Id}" : "/blocks";

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        block = null;
        form = new BlockForm();
        parts = [];
        availableChildBlocks = [];
        selectedChildBlockId = 0;
        partMessage = null;

        if (Id.HasValue)
        {
            block = await DbContext.LearningBlocks
                .SingleOrDefaultAsync(learningBlock => learningBlock.Id == Id.Value);

            if (block is not null)
            {
                form.Title = block.Title;
                form.Description = block.Description;
                form.Status = block.Status;
            }

            await LoadPartsAsync();
        }

        isLoading = false;
    }

    private async Task SaveBlockAsync()
    {
        var now = DateTime.UtcNow;

        if (block is null)
        {
            block = new LearningBlock
            {
                CreatedAt = now
            };

            DbContext.LearningBlocks.Add(block);
        }

        block.Title = form.Title.Trim();
        block.Description = form.Description ?? string.Empty;
        block.Status = form.Status;
        block.UpdatedAt = now;

        await DbContext.SaveChangesAsync();
        Navigation.NavigateTo($"/blocks/{block.Id}");
    }

    private async Task LoadPartsAsync()
    {
        selectedChildBlockId = 0;

        if (block is null)
        {
            parts = [];
            availableChildBlocks = [];
            return;
        }

        parts = await DbContext.BlockParts
            .AsNoTracking()
            .Include(part => part.ChildBlock)
            .Where(part => part.ParentBlockId == block.Id)
            .OrderBy(part => part.ChildBlock.Title)
            .ThenBy(part => part.ChildBlockId)
            .ToListAsync();

        var childBlockIds = parts
            .Select(part => part.ChildBlockId)
            .ToList();

        availableChildBlocks = await DbContext.LearningBlocks
            .AsNoTracking()
            .Where(learningBlock => learningBlock.Id != block.Id && !childBlockIds.Contains(learningBlock.Id))
            .OrderBy(learningBlock => learningBlock.Title)
            .ThenBy(learningBlock => learningBlock.Id)
            .ToListAsync();
    }

    private async Task AddPartAsync()
    {
        partMessage = null;

        if (block is null || selectedChildBlockId == 0)
        {
            partMessage = "Bitte wähle zuerst einen Baustein aus.";
            return;
        }

        if (selectedChildBlockId == block.Id)
        {
            partMessage = "Ein Baustein kann nicht sein eigener Bestandteil sein.";
            return;
        }

        var childBlockExists = await DbContext.LearningBlocks
            .AnyAsync(learningBlock => learningBlock.Id == selectedChildBlockId);

        var partAlreadyExists = await DbContext.BlockParts
            .AnyAsync(part => part.ParentBlockId == block.Id && part.ChildBlockId == selectedChildBlockId);

        if (!childBlockExists || partAlreadyExists)
        {
            partMessage = "Dieser Bestandteil kann nicht hinzugefügt werden.";
            await LoadPartsAsync();
            return;
        }

        DbContext.BlockParts.Add(new BlockPart
        {
            ParentBlockId = block.Id,
            ChildBlockId = selectedChildBlockId
        });

        await DbContext.SaveChangesAsync();
        await LoadPartsAsync();
    }

    private async Task RemovePartAsync(int partId)
    {
        partMessage = null;

        if (block is null)
        {
            return;
        }

        var part = await DbContext.BlockParts
            .SingleOrDefaultAsync(part => part.Id == partId && part.ParentBlockId == block.Id);

        if (part is null)
        {
            await LoadPartsAsync();
            return;
        }

        DbContext.BlockParts.Remove(part);
        await DbContext.SaveChangesAsync();
        await LoadPartsAsync();
    }

    private static string GetStatusText(BlockStatus status) => status switch
    {
        BlockStatus.Open => "Offen",
        BlockStatus.InProgress => "In Arbeit",
        BlockStatus.Understood => "Verstanden",
        _ => status.ToString()
    };

    private sealed class BlockForm
    {
        [Required(ErrorMessage = "Der Titel ist erforderlich.")]
        public string Title { get; set; } = string.Empty;

        public string? Description { get; set; } = string.Empty;

        public BlockStatus Status { get; set; } = BlockStatus.Open;
    }
}
