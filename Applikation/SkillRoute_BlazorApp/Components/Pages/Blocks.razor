@page "/blocks"

<PageTitle>Verwaltung</PageTitle>

<h1>Verwaltung</h1>

<p class="text-muted">
    Hier werden später die Lernblöcke erstellt, bearbeitet und gelöscht.
</p>

<div class="row g-3">
    <div class="col-md-6 col-xl-4">
        <div class="card h-100 skill-card">
            <div class="card-body">
                <h2 class="h5 card-title">Grundlagen C#</h2>
                <p class="card-text">
                    Einstieg in Variablen, Bedingungen und Schleifen.
                </p>
                <p class="mb-3">
                    <span class="badge text-bg-success">Status: Aktiv</span>
                </p>
                <button class="btn btn-primary btn-sm me-2" type="button">Bearbeiten</button>
                <button class="btn btn-outline-danger btn-sm" type="button">Löschen</button>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-4">
        <div class="card h-100 skill-card">
            <div class="card-body">
                <h2 class="h5 card-title">Objektorientierung</h2>
                <p class="card-text">
                    Klassen, Objekte und einfache Beziehungen zwischen Klassen.
                </p>
                <p class="mb-3">
                    <span class="badge text-bg-warning">Status: In Planung</span>
                </p>
                <button class="btn btn-primary btn-sm me-2" type="button">Bearbeiten</button>
                <button class="btn btn-outline-danger btn-sm" type="button">Löschen</button>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-4">
        <div class="card h-100 skill-card">
            <div class="card-body">
                <h2 class="h5 card-title">Blazor Einstieg</h2>
                <p class="card-text">
                    Erste Seiten, Navigation und einfache Komponenten.
                </p>
                <p class="mb-3">
                    <span class="badge text-bg-secondary">Status: Entwurf</span>
                </p>
                <button class="btn btn-primary btn-sm me-2" type="button">Bearbeiten</button>
                <button class="btn btn-outline-danger btn-sm" type="button">Löschen</button>
            </div>
        </div>
    </div>
</div>
