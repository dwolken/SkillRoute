@page "/blocks"

<PageTitle>Verwaltung</PageTitle>

<div class="page-header">
    <h1>Verwaltung</h1>
    <p class="lead">
        Eine einfache Liste mit Lernblöcken.
    </p>
</div>

<div class="row g-3">
    <div class="col-md-6 col-xl-4">
        <div class="card simple-card h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Grundlagen C#</h2>
                <p class="card-text">
                    Einstieg in Variablen, Bedingungen und Schleifen.
                </p>
                <p class="text-muted">Status: Aktiv</p>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary btn-sm" type="button">Bearbeiten</button>
                    <button class="btn btn-outline-secondary btn-sm" type="button">Löschen</button>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-4">
        <div class="card simple-card h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Objektorientierung</h2>
                <p class="card-text">
                    Klassen, Objekte und einfache Beziehungen zwischen Klassen.
                </p>
                <p class="text-muted">Status: In Planung</p>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary btn-sm" type="button">Bearbeiten</button>
                    <button class="btn btn-outline-secondary btn-sm" type="button">Löschen</button>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-4">
        <div class="card simple-card h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Blazor Einstieg</h2>
                <p class="card-text">
                    Erste Seiten, Navigation und einfache Komponenten.
                </p>
                <p class="text-muted">Status: Entwurf</p>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary btn-sm" type="button">Bearbeiten</button>
                    <button class="btn btn-outline-secondary btn-sm" type="button">Löschen</button>
                </div>
            </div>
        </div>
    </div>
</div>
