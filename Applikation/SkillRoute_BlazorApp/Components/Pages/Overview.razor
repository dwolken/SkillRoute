@page "/overview"
@using Microsoft.EntityFrameworkCore
@using SkillRoute_BlazorApp.Infrastructure
@using SkillRoute_BlazorApp.Model
@inject SkillRouteDbContext DbContext

<PageTitle>Übersicht</PageTitle>

<div class="page-header">
    <h1>Übersicht</h1>
    <p class="lead">Die Übersicht zeigt, wie Lernblöcke zusammenhängen.</p>
</div>

@if (topLevelBlocks == null)
{
    <p>Lade...</p>
}
else if (!topLevelBlocks.Any())
{
    <p>Es sind noch keine Verbindungen zwischen Bausteinen vorhanden.</p>
}
else
{
    <ul class="list-unstyled">
        @foreach (var block in topLevelBlocks)
        {
            <li class="mb-3">
                @RenderBlock(block, new HashSet<int>())
            </li>
        }
    </ul>
}

@code {
    private List<LearningBlock>? topLevelBlocks;
    private List<LearningBlock> allBlocks = [];
    private List<BlockPart> allParts = [];

    protected override async Task OnInitializedAsync()
    {
        allBlocks = await DbContext.LearningBlocks.ToListAsync();
        allParts = await DbContext.BlockParts.ToListAsync();

        var childIds = allParts.Select(p => p.ChildBlockId).ToHashSet();
        topLevelBlocks = allBlocks
            .Where(b => !childIds.Contains(b.Id))
            .Where(b => allParts.Any(p => p.ParentBlockId == b.Id))
            .ToList();
    }

    private RenderFragment RenderBlock(LearningBlock block, HashSet<int> visited) => __builder =>
    {
        if (visited.Contains(block.Id)) return;
        visited.Add(block.Id);

        var children = allParts
            .Where(p => p.ParentBlockId == block.Id)
            .Select(p => allBlocks.FirstOrDefault(b => b.Id == p.ChildBlockId))
            .Where(b => b != null)
            .Cast<LearningBlock>()
            .ToList();

        <div class="border rounded p-2 mb-2">
            <div class="d-flex justify-content-between align-items-center">
                <strong>@block.Title</strong>
                <span class="text-muted small">@StatusText(block.Status)</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(block.Description))
            {
                <div class="text-muted small mt-1">@block.Description</div>
            }
            <a href="/blocks/@block.Id" class="btn btn-sm btn-outline-secondary mt-2">Öffnen</a>

            @if (children.Any())
            {
                <ul class="list-unstyled mt-2 ms-3">
                    @foreach (var child in children)
                    {
                        <li class="mb-2">
                            @RenderBlock(child, new HashSet<int>(visited))
                        </li>
                    }
                </ul>
            }
        </div>
    };

    private static string StatusText(BlockStatus status) => status switch
    {
        BlockStatus.Open => "Offen",
        BlockStatus.InProgress => "In Arbeit",
        BlockStatus.Understood => "Verstanden",
        _ => ""
    };
}